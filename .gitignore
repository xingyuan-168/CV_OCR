# Reproducible local dependencies and build output
/third_party/
/build*/
/cmake-build-*/
/outpush/
/output/
/dist/
/tmp*/
/temp*/
/Testing/
/test-results/
/.cache/
/.vs/
/.vscode/
/.idea/

# Compiled binaries are disposable except manifest-listed immutable deliveries.
*.dll
*.exe
*.lib
*.exp
*.pdb
*.obj
*.ilk
*.idb
*.nupkg
*.zip
*.whl
!release/
!release/v23.5/
!release/v23.5/CQ_AI_e_language_v23.5.zip
!release/v23.5/cq_ai_engine-0.14.5-py3-none-win_amd64.whl
!release/v23.6/
!release/v23.6/CQ_AI_e_language_v23.6.zip
!release/v23.6/cq_ai_engine-0.14.6-py3-none-win_amd64.whl
/release/.v23.5-stage-*/
/release/.v23.5-backup-*/

